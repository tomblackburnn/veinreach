{
  "rules": {
    "usernames": {
      "$name": {
        ".read": "auth != null && auth.token.email_verified === true",
        ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$name.matches(/^[a-z0-9_]{3,16}$/) && newData.parent().parent().child('users').child(auth.uid).child('name').val().toLowerCase() === $name"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "name": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,16}$/) && newData.parent().parent().parent().child('usernames').child(newData.val().toLowerCase()).val() === auth.uid"
        },
        "rooms": {
          "$slot": {
            ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && (!data.exists() || !newData.parent().parent().parent().parent().child('rooms').child(data.val()).exists())",
            ".validate": "$slot.matches(/^[1-5]$/) && newData.isString() && newData.parent().parent().parent().parent().child('rooms').child(newData.val()).child('meta').child('owner').val() === auth.uid"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
        ".write": "auth != null && data.child('meta').child('owner').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null && auth.token.email_verified === true",
          ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && !data.exists() && $room.matches(/^[A-Z2-9]{6}$/)",
          ".validate": "newData.hasChildren(['name', 'seed', 'size', 'v', 'owner', 'created', 'slot']) && newData.parent().parent().parent().child('users').child(auth.uid).child('rooms').child(newData.child('slot').val()).val() === $room",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
          },
          "seed": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "size": {
            ".validate": "newData.val() === 'small' || newData.val() === 'medium' || newData.val() === 'large'"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "owner": {
            ".validate": "newData.val() === auth.uid"
          },
          "created": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "slot": {
            ".validate": "newData.isString() && newData.val().matches(/^[1-5]$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "settings": {
          ".read": "auth != null && auth.token.email_verified === true",
          "locked": {
            ".write": "auth != null && root.child('rooms').child($room).child('meta').child('owner').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && auth.uid === $uid && (!newData.exists() || (!data.exists() && newData.parent().parent().child('meta').exists() && !root.child('rooms').child($room).child('bans').child($uid).exists() && root.child('rooms').child($room).child('settings').child('locked').val() !== true))) || (auth != null && root.child('rooms').child($room).child('meta').child('owner').val() === auth.uid && !newData.exists() && $uid !== auth.uid)",
            ".validate": "newData.hasChildren(['name', 'joined']) && newData.child('name').val() === root.child('users').child(auth.uid).child('name').val() && newData.child('joined').val() === now",
            "$other": {
              ".validate": "$other === 'name' || $other === 'joined'"
            }
          }
        },
        "bans": {
          ".read": "auth != null && root.child('rooms').child($room).child('meta').child('owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms').child($room).child('meta').child('owner').val() === auth.uid && $uid !== auth.uid",
            ".validate": "newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('at').val() === now"
          }
        },
        "time": {
          ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['time', 'day']) && newData.child('time').isNumber() && newData.child('day').isNumber()",
          "$other": {
            ".validate": "$other === 'time' || $other === 'day'"
          }
        },
        "flags": {
          "$flag": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists() && !data.exists()",
            ".validate": "newData.val() === true && $flag.matches(/^[A-Za-z0-9:_-]{1,40}$/)"
          }
        },
        "tiles": {
          "$k": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
            ".validate": "$k.matches(/^[0-9]{1,8}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() < 4294967296"
          }
        },
        "liquids": {
          "$k": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
            ".validate": "$k.matches(/^[0-9]{1,8}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() < 768"
          }
        },
        "chests": {
          "$k": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
            ".validate": "$k.matches(/^[0-9]{1,5}_[0-9]{1,5}$/) && newData.isString() && newData.val().length <= 6000"
          }
        },
        "paintings": {
          "$k": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
            ".validate": "$k.matches(/^[0-9]{1,5}_[0-9]{1,5}$/) && newData.isString() && newData.val().length <= 1200"
          }
        },
        "players": {
          "$uid": {
            ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists() && auth.uid === $uid) || (auth != null && auth.uid === $uid && !newData.exists()) || (auth != null && root.child('rooms').child($room).child('meta').child('owner').val() === auth.uid && !newData.exists())",
            ".validate": "newData.hasChildren(['name', 'info', 's']) && newData.child('name').val() === root.child('users').child(auth.uid).child('name').val()",
            "name": {
              ".validate": "newData.isString()"
            },
            "info": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "s": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "chat": {
          ".indexOn": [
            "t",
            "uid"
          ],
          "$msg": {
            ".write": "(auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists() && !data.exists()) || (auth != null && !newData.exists() && data.exists() && (data.child('uid').val() === auth.uid || (root.child('rooms').child($room).child('members').child(auth.uid).exists() && data.child('t').val() < now - 86400000)))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('uid').val() === auth.uid && newData.child('name').val() === root.child('users').child(auth.uid).child('name').val() && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 200 && newData.child('t').val() === now",
            "$other": {
              ".validate": "$other === 'uid' || $other === 'name' || $other === 'text' || $other === 't'"
            }
          }
        },
        "mobs": {
          "$tag": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
            ".validate": "$tag.matches(/^[a-z2-9]{5}$/) && newData.isString() && newData.val().length <= 60000"
          }
        },
        "ev": {
          ".indexOn": [
            "t"
          ],
          "$id": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('users').child(auth.uid).child('name').exists() && root.child('rooms').child($room).child('members').child(auth.uid).exists() && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['f', 't', 'e']) && newData.child('f').isString() && newData.child('f').val().matches(/^[a-z2-9]{5}$/) && newData.child('e').isString() && newData.child('e').val().length <= 20000 && newData.child('t').val() === now",
            "$other": {
              ".validate": "$other === 'f' || $other === 't' || $other === 'e'"
            }
          }
        }
      }
    }
  }
}
